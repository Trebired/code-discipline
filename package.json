{
  "name": "@trebired/code-discipline",
  "version": "3.0.0",
  "description": "Configurable codebase discipline checks and rule-driven fixes for Bun and Node.js projects.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "typescript",
    "imports",
    "path-aliases",
    "node",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/code-discipline"
  },
  "bugs": {
    "url": "https://github.com/Trebired/code-discipline/issues"
  },
  "homepage": "https://github.com/Trebired/code-discipline#readme",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.12",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "code-discipline": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/*.node",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:native": "node ./scripts/build/native.mjs",
    "build:native:matrix": "node ./scripts/build/native-matrix.mjs",
    "demo": "bun run examples/dummy.ts",
    "discipline": "bun node_modules/@trebired/code-discipline/dist/cli.js check",
    "discipline:fix": "bun node_modules/@trebired/code-discipline/dist/cli.js fix",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "publish:npm": "bun run build:native:matrix && npm publish",
    "publish:npm:host": "bun run build:native && npm publish",
    "test": "bun node_modules/@trebired/code-discipline/dist/cli.js gate -- bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trebired/logger-adapter": "^0.2.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@trebired/code-discipline": "file:.",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1"
  }
}
